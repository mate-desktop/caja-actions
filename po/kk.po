msgid "file:///path/to/file1.mid"
msgstr "file:///path/to/file1.mid"

#: src/core/na-tokens.c:250
msgid "file:///path/to/file2.jpeg"
msgstr "file:///path/to/file2.jpeg"

#: src/core/na-tokens.c:251
msgid "audio/x-midi"
msgstr "audio/x-midi"

#: src/core/na-tokens.c:252
msgid "image/jpeg"
msgstr "image/jpeg"

#: src/core/na-tokens.c:254
msgid "test.example.net"
msgstr "test.example.net"

#: src/core/na-tokens.c:255
msgid "user"
msgstr "user"

#: src/core/na-tokens.c:441
msgid "Output of the run command"
msgstr "Орындалған команданың шығысы"

#: src/core/na-tokens.c:449
msgid "Run command:"
msgstr "Орындалатын команда:"

#: src/core/na-tokens.c:450
msgid "Standard output:"
msgstr "Стандартты шығыс:"

#: src/core/na-tokens.c:451
